# OptiAgent AI Service — environment variables
# Copy to .env and fill in values. Never commit .env.
#
# Required now     ← will cause startup failure if missing
# Optional (IncrN) ← needed when that increment is implemented

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8100

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Security (required now) ───────────────────────────────────────────────────
# Shared with the Node backend. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=change-me-generate-with-openssl-rand-hex-32
# Header the Node gateway uses to send the internal token. Rarely changed.
TOKEN_HEADER_NAME=X-Internal-Token

# ── CORS ─────────────────────────────────────────────────────────────────────
# Browsers never call this service directly. Leave empty unless debugging locally.
ALLOWED_ORIGINS=

# ── Vector database (Increment 6) ─────────────────────────────────────────────
CHROMA_URL=http://localhost:8200

# ── LLM providers (Increment 8) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Redis / conversation memory (Increment 10) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
