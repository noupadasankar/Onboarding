# --- Backend (Node/Express gateway) ---
NODE_ENV=development
BACKEND_PORT=8000
LOG_LEVEL=info

# PostgreSQL (Prisma). Matches docker/docker-compose.yml.
DATABASE_URL=postgresql://optiagent:change-me-in-prod@localhost:5432/optiagent?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — RS256 keypair (generate with `node scripts/generate-keys.mjs`).
# Paths are relative to the backend package root.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=optiagent
JWT_AUDIENCE=optiagent-clients

# CORS — comma-separated allowlist of browser origins.
CORS_ORIGINS=http://localhost:3000

# Rate limiting (login endpoint)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Downstream AI service
AI_SERVICE_URL=http://localhost:8100
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
