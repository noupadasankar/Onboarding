{
  "name": "@hr-onboarding/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts: DTOs, Zod schemas, API envelope for HR Onboarding AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
