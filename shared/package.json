    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "5.5.4",
    "zod": "^3.23.8"
  }
}
