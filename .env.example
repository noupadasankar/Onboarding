# ------------------------------------------------------------------------------
# OptiAgent — root example environment. Copy to `.env` for docker compose.
# Per-service overrides live in <service>/.env.example.
# ------------------------------------------------------------------------------

# --- PostgreSQL (owned by the Node backend) ---
POSTGRES_USER=optiagent
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=optiagent
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- ChromaDB (owned by the Python ai-service) ---
CHROMA_PORT=8001

# --- Service ports ---
BACKEND_PORT=8000
AI_SERVICE_PORT=8100
FRONTEND_PORT=3000

# --- Internal service-to-service trust (Node -> Python) ---
# Shared secret the Node gateway sends; the AI service verifies it and then
# trusts forwarded X-User-Id / X-User-Role headers. Never exposed to browsers.
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
